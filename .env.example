# ============================================
# Bark Detection System Configuration
# ============================================
# Copy this file to .env and adjust values for your setup

# --------------------------------------------
# Microphone Configuration
# --------------------------------------------
# USB Device ID for Blue Snowball microphone
# Format: vendorId:productId (find with: lsusb)
MICROPHONE_DEVICE_ID=0d8c:0005

# Audio sample rate in Hz (48000 for PipeWire, 44100 for direct ALSA)
# Note: Must match your microphone's supported sample rates (check with sounddevice)
SAMPLE_RATE=48000

# --------------------------------------------
# Bark Detection Parameters
# --------------------------------------------
# Minimum decibel level to consider as potential bark (in dBFS)
#
# ⚠️  IMPORTANT: Uses dBFS (decibels Full Scale) - a digital audio measurement
#     where 0 dBFS is maximum and all real audio is NEGATIVE
#
# Typical values:
#   -60 to -50 dBFS: Very quiet ambient noise
#   -50 to -30 dBFS: Normal household sounds
#   -30 to -10 dBFS: Loud sounds, barks, shouting
#   -10 to 0 dBFS:   Very loud, near clipping
#
# Range: -60 to 0 dBFS (higher/less negative = less sensitive)
# Start with -30 and tune using --debug mode to see actual audio levels
BARK_THRESHOLD_DB=-30

# Minimum duration in milliseconds for sustained sound to count as bark
# Range: 50-500 ms (prevents detecting brief transient noises)
MIN_BARK_DURATION_MS=100

# Cooldown period between detections in milliseconds
# Range: 200-2000 ms (prevents multiple triggers for single bark)
COOLDOWN_PERIOD_MS=500

# --------------------------------------------
# MQTT Broker Configuration
# --------------------------------------------
# Hostname or IP address of your MQTT broker
# Examples: localhost, homeassistant.local, 192.168.1.100
MQTT_BROKER=homeassistant.local

# MQTT broker port (default: 1883)
MQTT_PORT=1883

# MQTT authentication credentials
MQTT_USERNAME=bark_detector
MQTT_PASSWORD=your_secure_password_here

# MQTT topic for publishing bark events
MQTT_TOPIC=homeassistant/sensor/bark_detector/state

# Unique client ID for this MQTT client
MQTT_CLIENT_ID=bark_detector

# --------------------------------------------
# Logging Configuration
# --------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR
# DEBUG: Detailed per-chunk analysis (verbose)
# INFO: Service events and bark detections (recommended)
# WARNING: Only warnings and errors
# ERROR: Only errors
#
# 💡 TIP: Use --debug flag when running to get real-time audio levels
#    for calibrating BARK_THRESHOLD_DB:
#    uv run python -m bark_detector.main --debug
LOG_LEVEL=INFO
